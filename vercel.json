{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/css/(.*)", "destination": "/frontend/css/$1" },
    { "source": "/js/(.*)", "destination": "/frontend/js/$1" },
    { "source": "/(index|login|noticias|horarios|resultados|galeria|panel-admin|panel-director|panel-jugador).html", "destination": "/frontend/$1.html" },
    { "source": "/(index|login|noticias|horarios|resultados|galeria|panel-admin|panel-director|panel-jugador)", "destination": "/frontend/$1.html" },
    { "source": "/(.*)", "destination": "/frontend/index.html" }
  ]
}
