# -------------------------------------------------
# Copiar este archivo como ".env" y completar los datos reales
# -------------------------------------------------

# Puerto del servidor
PORT=3000

# PostgreSQL (pgAdmin)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=club_voley
DB_USER=postgres
DB_PASSWORD=Alex

# JWT
JWT_SECRET=genera_aqui_una_clave_larga_y_aleatoria

# Despliegue (Supabase + Vercel)
# DB_SSL=true es OBLIGATORIO si la base está en Supabase (exige conexiones SSL)
# CORS_ORIGINS: dominios extra autorizados, separados por coma
#   ej: https://tu-app.vercel.app
# DB_POOL_MAX: conexiones simultáneas del pool (usar 5-10 con el pooler de Supabase)
DB_SSL=false
CORS_ORIGINS=
DB_POOL_MAX=10

# Gmail (para el envío de mensajes a jugadores y directores)
# EMAIL_USER: la cuenta de Gmail del club
# EMAIL_PASS: NO es la contraseña normal de Gmail, es una "contraseña de aplicación"
#   1) Activar verificación en 2 pasos en la cuenta de Gmail
#   2) Ir a https://myaccount.google.com/apppasswords
#   3) Generar una contraseña de aplicación para "Correo"
#   4) Pegar esa clave de 16 caracteres aquí (sin espacios)
EMAIL_USER=tuclub@gmail.com
EMAIL_PASS=xxxxxxxxxxxxxxxx
